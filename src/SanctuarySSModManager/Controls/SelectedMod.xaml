<UserControl x:Class="SanctuarySSModManager.Controls.SelectedMod"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SanctuarySSModManager.Controls"
            xmlns:localMisc="clr-namespace:SanctuarySSModManager.MiscUtil"
            xmlns:enums="clr-namespace:SanctuarySSLib.Enums;assembly=SanctuarySSLib"
             mc:Ignorable="d" d:DesignWidth="800" Height="49">
    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <StackPanel Name="SelectedModPanel" Orientation="Horizontal">
            <Label Content="Selected Mod"/>
            <ListView Name="CurrentlySelectedMod">None</ListView>
            <Label Content="Lua Folder"/>
            <ListBox 
                        Width="70px" 
                        SelectionMode="Single" 
                        SelectedItem="{Binding LuaFolder, Mode=TwoWay}"
                        ItemsSource="{Binding LuaFolders}">
            </ListBox>
        </StackPanel>
    </StackPanel>
</UserControl>
