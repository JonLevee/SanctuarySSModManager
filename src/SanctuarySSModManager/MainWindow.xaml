<Window x:Class="SanctuarySSModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SanctuarySSModManager"
        xmlns:controls="clr-namespace:SanctuarySSModManager.Controls"
        xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:localMisc="clr-namespace:SanctuarySSModManager.MiscUtil"
        xmlns:enums="clr-namespace:SanctuarySSLib.Enums;assembly=SanctuarySSLib"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closing="OnClosing"    
        >
    <Window.Resources>

    </Window.Resources>
    <DockPanel LastChildFill="True" x:Name="OuterDock">

        <StackPanel Orientation="Vertical" DockPanel.Dock="Top">
            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="100" Content="Sanctuary Shattered Sun Mod Manager" HorizontalAlignment="Center"/>
            <controls:SelectedMod>
                
            </controls:SelectedMod>
            <TabControl Name="Tab">
                <TabItem Name="ModManagerTab" Header="Mod Manager">

                </TabItem>
                <TabItem Name="ModCreatorTab" Header="Mod Creator">

                </TabItem>
                <TabItem Name="OptionsTab" Header="Options">

                </TabItem>
            </TabControl>
        </StackPanel>
    </DockPanel>
</Window>
