<Window x:Class="SanctuarySSModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SanctuarySSModManager"
        xmlns:controls="clr-namespace:SanctuarySSModManager.Controls"
        xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:localMisc="clr-namespace:SanctuarySSModManager.MiscUtil"
        xmlns:enums="clr-namespace:SanctuarySSLib.Enums;assembly=SanctuarySSLib"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"    
        >
    <Window.Resources>

    </Window.Resources>
    <DockPanel LastChildFill="True" x:Name="OuterDock">

        <StackPanel Orientation="Vertical" DockPanel.Dock="Top">
            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="100" Content="Sanctuary Shattered Sun Mod Manager" HorizontalAlignment="Center"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel Name="SelectedModPanel" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Enable Mods"/>
                        <CheckBox IsChecked="{Binding ModManagerEnabled}" />
                    </StackPanel>
                    <Label Content="Selected Mod" IsEnabled="{Binding ModManagerEnabled}"/>
                    <ListView 
                        Name="CurrentlySelectedMod"
                        IsEnabled="{Binding ModManagerEnabled}">
                        None
                    </ListView>
                    <Label Content="Lua Folder" IsEnabled="{Binding ModManagerEnabled}"/>
                    <ListBox 
                        Width="70px" 
                        SelectionMode="Single" 
                        IsEnabled="{Binding ModManagerEnabled}"
                        SelectedItem="{Binding LuaFolder, Mode=TwoWay}"
                        ItemsSource="{Binding LuaFolders}">
                    </ListBox>
                </StackPanel>
            </StackPanel>
            <TabControl Name="Tab" IsEnabled="{Binding ModManagerEnabled}">
                <TabItem Name="ModManagerTab" Header="Mod Manager">

                </TabItem>
                <TabItem Name="ModCreatorTab" Header="Mod Creator">

                </TabItem>
                <TabItem Name="OptionsTab" Header="Options">

                </TabItem>
            </TabControl>
        </StackPanel>
    </DockPanel>
</Window>
